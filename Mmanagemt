      karat: '24K',
      value: 9500
    }
  ]);

  private readonly _cash = signal<Cash[]>([
    {
      country: 'india',
      checking: 7000,
      savings: 11500
    },
    {
      country: 'usa',
      checking: 15000,
      savings: 35000
    }
  ]);

  properties = this._properties.asReadonly();
  gold = this._gold.asReadonly();
  cash = this._cash.asReadonly();

  getProperties(country: 'india' | 'usa') {
    return this._properties()
      .filter(property => property.country === country);
  }

  getProperty(id: number) {
    return this._properties()
      .find(property => property.id === id);
  }

  getGold(country: 'india' | 'usa') {
    return this._gold()
      .find(gold => gold.country === country);
  }

  getCash(country: 'india' | 'usa') {
    return this._cash()
      .find(cash => cash.country === country);
  }
}

