export type Country = 'india' | 'usa';
export type AssetType = 'property' | 'gold' | 'cash';

export interface Property {
  id: number;
  name: string;
  location: string;
  value: number;
  image: string;
  country: Country;
}

export interface Gold {
  country: Country;
  grams: number;
  karat: string;
  value: number;
}

export interface Cash {
  country: Country;
  checking: number;
  savings: number;
}

export interface CountryAssets {
  country: Country;
  properties: Property[];
  gold: Gold;
  cash: Cash;
}
