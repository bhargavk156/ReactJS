import {
  ChangeDetectionStrategy,
  Component,
  computed,
  inject
} from '@angular/core';

import { CurrencyPipe } from '@angular/common';
import { RouterLink } from '@angular/router';
import { AssetService } from '../../core/services/asset.service';

@Component({
  selector: 'app-dashboard',
  standalone: true,

  imports: [
    CurrencyPipe,
    RouterLink
  ],

  templateUrl: './dashboard.component.html',
  styleUrl: './dashboard.component.scss',

  changeDetection: ChangeDetectionStrategy.OnPush
})
export class DashboardComponent {

  private readonly assetService = inject(AssetService);

  readonly properties = this.assetService.properties;
  readonly gold = this.assetService.gold;
  readonly cash = this.assetService.cash;

  readonly indiaProperties = computed(() =>
    this.properties().filter(p => p.country === 'india')
  );

  readonly usaProperties = computed(() =>
    this.properties().filter(p => p.country === 'usa')
  );

  readonly propertyTotal = computed(() =>
    this.properties().reduce(
      (total, property) => total + property.value,
      0
    )
  );

  readonly goldTotal = computed(() =>
    this.gold().reduce(
      (total, gold) => total + gold.value,
      0
    )
  );

  readonly cashTotal = computed(() =>
    this.cash().reduce(
      (total, cash) =>
        total + cash.checking + cash.savings,
      0
    )
  );

  readonly netWorth = computed(() =>
    this.propertyTotal()
    + this.goldTotal()
    + this.cashTotal()
  );

  getGold(country: 'india' | 'usa') {
    return this.assetService.getGold(country);
  }

  getCash(country: 'india' | 'usa') {
    return this.assetService.getCash(country);
  }
}

