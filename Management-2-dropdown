india.component.scss
:host {
  display: block;
  min-height: 100vh;
  background: #f5f7fb;
}

.asset-page {
  width: min(1200px, 92%);
  margin: auto;
  padding: 45px 0;
}

.page-header {
  margin-bottom: 35px;
}

.country-title {
  display: flex;
  align-items: center;
  gap: 15px;

  .flag {
    font-size: 42px;
  }

  h1 {
    margin: 0 0 5px;
    font-size: 28px;
    color: #152238;
  }

  p {
    margin: 0;
    color: #7b8798;
  }
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
}

.asset-card {
  min-height: 190px;

  display: flex;
  align-items: center;
  gap: 24px;

  padding: 30px;

  border-radius: 16px;
  border: 1px solid #e2e7ee;

  background: white;

  text-decoration: none;
  color: #17243a;

  box-shadow: 0 5px 20px rgba(25, 42, 70, .05);

  transition:
    transform .2s ease,
    box-shadow .2s ease;

  &:hover {
    transform: translateY(-5px);

    box-shadow:
      0 15px 35px rgba(25, 42, 70, .12);
  }

  .icon {
    width: 75px;
    height: 75px;

    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 16px;

    font-size: 34px;
    font-weight: 800;
  }

  h2 {
    margin: 0 0 7px;
    font-size: 21px;
  }

  p {
    margin: 0 0 18px;
    color: #7d899a;
    font-size: 13px;
  }

  span {
    color: #2867b2;
    font-size: 13px;
    font-weight: 600;
  }
}

.house .icon {
  background: #e8f1ff;
}

.land .icon {
  background: #e8f8ed;
}

.gold .icon {
  background: #fff5d5;
  color: #d79c00;
}

.cash .icon {
  background: #e5f8ef;
  color: #16885c;
}

@media (max-width: 750px) {

  .asset-grid {
    grid-template-columns: 1fr;
  }

}


