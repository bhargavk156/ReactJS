1. Routes

import { Routes } from '@angular/router';

export const routes: Routes = [

  {
    path: '',
    redirectTo: 'dashboard',
    pathMatch: 'full'
  },

  {
    path: 'dashboard',
    loadComponent: () =>
      import('./features/dashboard/dashboard.component')
        .then(m => m.DashboardComponent)
  },

  // ==========================
  // INDIA
  // ==========================

  {
    path: 'india',
    loadComponent: () =>
      import('./features/india/india.component')
        .then(m => m.IndiaComponent)
  },

  {
    path: 'india/houses',
    loadComponent: () =>
      import('./features/india/houses/houses.component')
        .then(m => m.HousesComponent)
  },

  {
    path: 'india/lands',
    loadComponent: () =>
      import('./features/india/lands/lands.component')
        .then(m => m.LandsComponent)
  },

  {
    path: 'india/gold',
    loadComponent: () =>
      import('./features/india/gold/gold.component')
        .then(m => m.GoldComponent)
  },

  {
    path: 'india/cash',
    loadComponent: () =>
      import('./features/india/cash/cash.component')
        .then(m => m.CashComponent)
  },

  // ==========================
  // USA
  // ==========================

  {
    path: 'usa',
    loadComponent: () =>
      import('./features/usa/usa.component')
        .then(m => m.UsaComponent)
  },

  {
    path: 'usa/houses',
    loadComponent: () =>
      import('./features/usa/houses/houses.component')
        .then(m => m.HousesComponent)
  },

  {
    path: 'usa/cash',
    loadComponent: () =>
      import('./features/usa/cash/cash.component')
        .then(m => m.CashComponent)
  },

  {
    path: 'usa/stocks',
    loadComponent: () =>
      import('./features/usa/stocks/stocks.component')
        .then(m => m.StocksComponent)
  },

  {
    path: '**',
    redirectTo: 'dashboard'
  }

];

