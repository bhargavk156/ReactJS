export const routes: Routes = [

  {
    path: '',
    redirectTo: 'dashboard',
    pathMatch: 'full'
  },

  {
    path: 'dashboard',
    loadComponent: () =>
      import('./features/dashboard/dashboard.component')
        .then(m => m.DashboardComponent)
  },

  {
    path: 'assets/:country',
    loadComponent: () =>
      import('./features/assets/asset-home/asset-home.component')
        .then(m => m.AssetHomeComponent)
  },

  // HOUSES

  {
    path: 'assets/:country/houses',
    loadComponent: () =>
      import('./features/houses/house-list/house-list.component')
        .then(m => m.HouseListComponent)
  },

  {
    path: 'assets/:country/houses/add',
    loadComponent: () =>
      import('./features/houses/house-form/house-form.component')
        .then(m => m.HouseFormComponent)
  },

  {
    path: 'assets/:country/houses/:id/edit',
    loadComponent: () =>
      import('./features/houses/house-form/house-form.component')
        .then(m => m.HouseFormComponent)
  },

  // GOLD

  {
    path: 'assets/:country/gold',
    loadComponent: () =>
      import('./features/gold/gold-list/gold-list.component')
        .then(m => m.GoldListComponent)
  },

  {
    path: 'assets/:country/gold/add',
    loadComponent: () =>
      import('./features/gold/gold-form/gold-form.component')
        .then(m => m.GoldFormComponent)
  },

  // BANKING

  {
    path: 'assets/:country/banking',
    loadComponent: () =>
      import('./features/banking/banking-list/banking-list.component')
        .then(m => m.BankingListComponent)
  },

  {
    path: 'assets/:country/banking/add',
    loadComponent: () =>
      import('./features/banking/banking-form/banking-form.component')
        .then(m => m.BankingFormComponent)
  },

  // STOCKS

  {
    path: 'assets/:country/stocks',
    loadComponent: () =>
      import('./features/stocks/stock-list/stock-list.component')
        .then(m => m.StockListComponent)
  },

  {
    path: 'assets/:country/stocks/add',
    loadComponent: () =>
      import('./features/stocks/stock-form/stock-form.component')
        .then(m => m.StockFormComponent)
  }

];

